[
  {
    "id": "ex9.tab",
    "type": "tab",
    "label": "openccu-loom – Backup sichern",
    "disabled": false,
    "info": "Stößt nachts ein CCU-Backup an und legt das jüngste Archiv als Datei ab.\n\nDer obere Strang läuft um 03:00: `trigger` bittet die CCU um ein frisches Backup. Die CCU braucht dafür einen Moment, deshalb wartet der delay-Node, bevor `list` die gespeicherten Archive holt; der change-Node greift sich den ersten Eintrag (die Liste kommt neueste zuerst) und `download` lädt ihn.\n\nWichtig für den file-out-Node: `download` liefert `msg.payload` als rohen Buffer, nicht als JSON — deshalb steht dort \"Nur den Payload schreiben\" (`encoding: none`). Ein als Text geschriebenes .sbk wäre unbrauchbar.\n\nDer untere Strang zeigt den Gegenweg: eine .sbk-Datei einlesen und per `upload` in den Daemon importieren. Der file-in-Node muss dafür einen Buffer ausgeben."
  },
  {
    "id": "ex9.server",
    "type": "openccu-loom-server",
    "name": "openccu-loom localhost",
    "host": "127.0.0.1",
    "port": 8119,
    "tls": false,
    "insecureTLS": false,
    "authMethod": "basic",
    "timeout": 30000
  },
  {
    "id": "ex9.inject",
    "type": "inject",
    "z": "ex9.tab",
    "name": "täglich 03:00",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "00 03 * * *",
    "once": false,
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 100,
    "wires": [["ex9.trigger"]]
  },
  {
    "id": "ex9.trigger",
    "type": "openccu-loom-backups",
    "z": "ex9.tab",
    "name": "Backup anstoßen",
    "server": "ex9.server",
    "action": "trigger",
    "backupId": "",
    "centralName": "Home",
    "filename": "",
    "x": 370,
    "y": 100,
    "wires": [["ex9.wait"]]
  },
  {
    "id": "ex9.wait",
    "type": "delay",
    "z": "ex9.tab",
    "name": "2 min warten",
    "pauseType": "delay",
    "timeout": "2",
    "timeoutUnits": "minutes",
    "rate": "1",
    "nbRateUnits": "1",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": false,
    "x": 580,
    "y": 100,
    "wires": [["ex9.list"]]
  },
  {
    "id": "ex9.list",
    "type": "openccu-loom-backups",
    "z": "ex9.tab",
    "name": "Archive auflisten",
    "server": "ex9.server",
    "action": "list",
    "backupId": "",
    "centralName": "",
    "filename": "",
    "x": 780,
    "y": 100,
    "wires": [["ex9.pick"]]
  },
  {
    "id": "ex9.pick",
    "type": "change",
    "z": "ex9.tab",
    "name": "jüngstes Archiv wählen",
    "rules": [
      { "t": "set", "p": "backupId", "pt": "msg", "to": "payload[0].id", "tot": "msg" },
      {
        "t": "set",
        "p": "filename",
        "pt": "msg",
        "to": "\"/tmp/ccu-\" & payload[0].id & \".sbk\"",
        "tot": "jsonata"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 1010,
    "y": 100,
    "wires": [["ex9.download"]]
  },
  {
    "id": "ex9.download",
    "type": "openccu-loom-backups",
    "z": "ex9.tab",
    "name": "herunterladen",
    "server": "ex9.server",
    "action": "download",
    "backupId": "",
    "centralName": "",
    "filename": "",
    "x": 1230,
    "y": 100,
    "wires": [["ex9.file"]]
  },
  {
    "id": "ex9.file",
    "type": "file",
    "z": "ex9.tab",
    "name": "als .sbk speichern",
    "filename": "filename",
    "filenameType": "msg",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "true",
    "encoding": "none",
    "x": 1430,
    "y": 100,
    "wires": [["ex9.debug"]]
  },
  {
    "id": "ex9.debug",
    "type": "debug",
    "z": "ex9.tab",
