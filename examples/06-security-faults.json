[
  {
    "id": "ex6.tab",
    "type": "tab",
    "label": "openccu-loom – Security: Störungen",
    "disabled": false,
    "info": "Liest das Störungsregister der Security-&-Safety-Domäne und quittiert jede noch offene Störung einzeln.\n\nDer obere Strang holt alle drei Minuten `GET /security/faults`, zerlegt die Liste in einzelne Meldungen und quittiert nur die, die noch nicht quittiert sind. Quittieren beseitigt eine Störung nicht — sie bleibt bestehen, bis ihre Ursache weg ist; es markiert sie nur als gesehen.\n\nDer untere Strang zeigt die Filter von `GET /security/sources`: hier alle Rauchmelder-Datenpunkte, die aktuell als relevant gelten."
  },
  {
    "id": "ex6.server",
    "type": "openccu-loom-server",
    "name": "openccu-loom localhost",
    "host": "127.0.0.1",
    "port": 8119,
    "tls": false,
    "insecureTLS": false,
    "authMethod": "basic",
    "timeout": 10000
  },
  {
    "id": "ex6.inject",
    "type": "inject",
    "z": "ex6.tab",
    "name": "alle 3 min",
    "props": [{ "p": "payload" }],
    "repeat": "180",
    "once": true,
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 100,
    "wires": [["ex6.faults"]]
  },
  {
    "id": "ex6.faults",
